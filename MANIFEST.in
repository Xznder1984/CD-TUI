# The installers and their checks ship in the sdist: they are the primary
# installation path, and tests/test_installers.py reads them, so leaving them out
# produces a source distribution whose own test suite cannot run.
include LICENSE
include README.md
include requirements.txt
include pytest.ini
include install.sh
include install.ps1

recursive-include tests *.py
recursive-include tests *.ps1

global-exclude __pycache__
global-exclude *.py[cod]
